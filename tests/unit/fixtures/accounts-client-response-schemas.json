                  "shortId",
                  "name",
                  "createdAt",
                  "updatedAt"
                ],
                "properties": {
                  "shortId": {
                    "type": "string",
                    "pattern": "^acc_[0-9A-HJKMNP-TV-Z]{8}$",
                    "example": "acc_7K3M9P2Q"
                  },
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string",
                    "nullable": true
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "DEPLOYING",
                  "DEPLOYED",
                  "FAILED",
                  "ARCHIVED"
                ]
              },
              "owners": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "threshold": {
                "type": "integer"
              },
              "saltNonce": {
                "type": "string"
              },
              "predictedAddress": {
                "type": "string",
                "nullable": true
              },
              "safeAddress": {
                "type": "string",
                "nullable": true
              },
              "provisionTxHash": {
                "type": "string",
                "nullable": true
              },
              "deployedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "failureCode": {
                "type": "string",
                "nullable": true
              },
              "failureMessage": {
                "type": "string",
                "nullable": true
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "archivedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "symbol",
                    "address",
                    "decimals"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "symbol": {
                      "type": "string"
                    },
                    "address": {
                      "type": "string",
                      "nullable": true,
                      "description": "Null address is the native currency."
                    },
                    "decimals": {
                      "type": "integer"
                    }
                  }
                }
              },
              "balances": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "tokenAddress",
                    "raw",
                    "formatted",
                    "updatedAt"
                  ],
                  "properties": {
                    "tokenAddress": {
                      "type": "string",
                      "nullable": true,
                      "description": "Null address is the native currency."
                    },
                    "raw": {
                      "type": "string"
                    },
                    "formatted": {
                      "type": "string"
                    },
                    "blockNumber": {
                      "type": "string",
                      "nullable": true
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        "400",
        "401",
        "403",
        "404"
      ]
