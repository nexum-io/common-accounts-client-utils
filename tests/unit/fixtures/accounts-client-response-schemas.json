              },
              "externalId": {
                "type": "string"
              },
              "network": {
                "type": "string"
              },
              "chainId": {
                "type": "integer",
                "nullable": true
              },
              "meta": {
                "type": "object",
                "description": "Embedded in every account response (DEV-340). `shortId` is server-generated and immutable.",
